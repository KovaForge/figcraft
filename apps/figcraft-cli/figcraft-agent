#!/usr/bin/env bash
# figcraft-agent — KovaForge agent-facing wrapper around figcraft-cli.
#
# This file lives in the KovaForge fork and is NOT upstream. The clean-room
# rule (AGENTS.md, "Non-negotiables") covers the Rust crates. A bash wrapper
# alongside the CLI is fine: it adds an agent-friendly surface without changing
# any crate, so upstream syncing stays a fast-forward.
#
# Conventions for agents:
#   * stdout is structured (one JSON object per line) for machine consumption
#   * file paths are absolute; no relative resolution against cwd
#   * render output goes to FIGCRAFT_OUT (default: $XDG_PICTURES_HOME/figcraft)
#   * MCP lifecycle: mcp-start (headless) and mcp-attach (running app)
#
# Agents should treat non-zero exits as blocking failures and stop the chain
# rather than retry. The wrapper never modifies the input .figcraft; reads only.

set -euo pipefail

# Resolve the workspace binary. cargo build --release -p figcraft-cli produces
# target/release/figcraft-cli. We prefer a release binary if present, fall back
# to a debug build, and as a last resort the source tree's xtask-launched one.
# Resolve the real path: when invoked through a symlink (e.g. ~/.local/bin/figcraft-agent),
# ${BASH_SOURCE[0]} is the symlink path. realpath() makes the workspace-root math correct
# whether or not the wrapper is symlinked.
SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

resolve_cli() {
  for cand in \
    "$WORKSPACE_ROOT/target/release/figcraft-cli" \
    "$WORKSPACE_ROOT/target/debug/figcraft-cli"; do
    if [[ -x "$cand" ]]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  if command -v figcraft-cli >/dev/null 2>&1; then
    command -v figcraft-cli
    return 0
  fi
  echo "figcraft-agent: figcraft-cli binary not found; run 'cargo build --release -p figcraft-cli'" >&2
  return 127
}

FIGCRAFT_CLI="$(resolve_cli)"
FIGCRAFT_OUT="${FIGCRAFT_OUT:-$HOME/Pictures/figcraft}"

# Emit one JSON line on stdout. Errors go to stderr.
emit() {
  printf '%s\n' "$1"
}

err() {
  printf 'figcraft-agent: %s\n' "$1" >&2
}

# Argv: one path
require_abs() {
  case "$1" in
    /*) ;;
    *) err "expected absolute path, got: $1"; return 2 ;;
  esac
}

usage() {
  cat <<'EOF'
figcraft-agent <subcommand> [args...]

  render <file.figcraft> [-o out.png] [--scale N]
        Render the file to PNG. Default scale 2 (KovaForge export default).
        Output: $FIGCRAFT_OUT (default $HOME/Pictures/figcraft).

  export <file.figcraft> --format svg|pdf|webp|jpg [--out-dir DIR]
        Export layers in the chosen format. Default out-dir $FIGCRAFT_OUT.

  info <file.figcraft>
        Print one-line JSON summary: pages, frames, components, lastSavedBy.

  commands [--filter REGEX]
        List the full command registry (or filter by regex). For agent planning.

  mcp-start
        Run the headless figcraft-cli MCP server in the foreground (stdio).
        The calling agent drives it via stdin/stdout; this wrapper does NOT
        background it (the server needs an active client on stdin). Use
        `mcp-stop` only if the previous `mcp-start` left a stray process;
        under normal foreground use there is nothing to stop.

  mcp-attach <port>
        Verify a running figcraft app's control channel port is reachable.
        The desktop app exposes a loopback control channel (separate from MCP);
        this does a cheap TCP probe and returns one JSON line.

  mcp-stop
        Stop the headless MCP server started by mcp-start.

Environment:
  FIGCRAFT_OUT   Output directory (default $HOME/Pictures/figcraft)
  CARGO_TARGET_DIR  Override the cargo target dir if you build per-agent.
EOF
}

cmd_render() {
  [[ $# -ge 1 ]] || { err "render: missing <file.figcraft>"; return 2; }
  local input="$1"; shift
  require_abs "$input" || return 2
  [[ -f "$input" ]] || { err "render: file not found: $input"; return 2; }

  local scale=2
  local out=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--out) out="$2"; shift 2 ;;
      --scale)  scale="$2"; shift 2 ;;
      *) err "render: unknown arg: $1"; return 2 ;;
    esac
  done

  if [[ -z "$out" ]]; then
    mkdir -p "$FIGCRAFT_OUT"
    local base
    base="$(basename "$input" .figcraft)"
    out="$FIGCRAFT_OUT/${base}-2x.png"
  fi
  mkdir -p "$(dirname "$out")"

  "$FIGCRAFT_CLI" render "$input" -o "$out" --scale "$scale"
  emit "{\"ok\":true,\"input\":\"$input\",\"output\":\"$out\",\"scale\":$scale}"
}

cmd_export() {
  [[ $# -ge 1 ]] || { err "export: missing <file.figcraft>"; return 2; }
  local input="$1"; shift
  require_abs "$input" || return 2
  [[ -f "$input" ]] || { err "export: file not found: $input"; return 2; }

  local fmt="" out_dir="$FIGCRAFT_OUT"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format)  fmt="$2"; shift 2 ;;
      --out-dir) out_dir="$2"; shift 2 ;;
      *) err "export: unknown arg: $1"; return 2 ;;
    esac
  done
  [[ -n "$fmt" ]] || { err "export: --format required (svg|pdf|webp|jpg)"; return 2; }

  mkdir -p "$out_dir"
  "$FIGCRAFT_CLI" export "$input" -o "$out_dir/" --format "$fmt"
  emit "{\"ok\":true,\"input\":\"$input\",\"outDir\":\"$out_dir\",\"format\":\"$fmt\"}"
}

cmd_info() {
  [[ $# -ge 1 ]] || { err "info: missing <file.figcraft>"; return 2; }
  local input="$1"; shift
  require_abs "$input" || return 2
  [[ -f "$input" ]] || { err "info: file not found: $input"; return 2; }
  # figcraft-cli has no `info` subcommand in 0.6.0; emit the raw output and let
  # the caller parse. Keeps the wrapper forward-compatible.
  "$FIGCRAFT_CLI" info "$input" 2>&1 || true
}

cmd_commands() {
  local filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --filter) filter="$2"; shift 2 ;;
      *) err "commands: unknown arg: $1"; return 2 ;;
    esac
  done
  if [[ -n "$filter" ]]; then
    "$FIGCRAFT_CLI" commands --filter "$filter"
  else
    "$FIGCRAFT_CLI" commands
  fi
}

# MCP lifecycle state lives under $FIGCRAFT_OUT/agent-state/.
agent_state_dir() {
  printf '%s/agent-state' "$FIGCRAFT_OUT"
}

cmd_mcp_start() {
  # The headless MCP server (figcraft-cli mcp) is stdio-driven: it reads MCP
  # requests from stdin and writes responses to stdout. We exec it in the
  # foreground so the calling agent's stdio is wired straight to the server.
  # Backgrounding would close stdin and the server would exit immediately.
  exec "$FIGCRAFT_CLI" mcp
}

cmd_mcp_attach() {
  [[ $# -ge 1 ]] || { err "mcp-attach: missing <port>"; return 2; }
  local port="$1"; shift
  # TCP connect probe; cheap and doesn't need the CLI binary.
  if (echo > "/dev/tcp/127.0.0.1/$port") >/dev/null 2>&1; then
    emit "{\"ok\":true,\"port\":$port}"
  else
    emit "{\"ok\":false,\"port\":$port,\"reason\":\"connect failed\"}"
    return 1
  fi
}

cmd_mcp_stop() {
  # mcp-start runs the server in the foreground under the calling agent's
  # stdio, so there is no background process for us to stop. This subcommand
  # remains so existing callers don't break; it is a no-op that explains.
  cat <<'EOF'
{"ok":true,"stopped":false,"reason":"mcp-start runs the server in the foreground under the caller's stdio; nothing to stop from here. Ctrl-C the caller, or kill the wrapping process."}
EOF
  return 0
}

main() {
  [[ $# -ge 1 ]] || { usage; return 2; }
  local sub="$1"; shift
  case "$sub" in
    render)    cmd_render "$@" ;;
    export)    cmd_export "$@" ;;
    info)      cmd_info "$@" ;;
    commands)  cmd_commands "$@" ;;
    mcp-start) cmd_mcp_start "$@" ;;
    mcp-attach) cmd_mcp_attach "$@" ;;
    mcp-stop)  cmd_mcp_stop "$@" ;;
    -h|--help|help) usage ;;
    *) err "unknown subcommand: $sub"; usage; return 2 ;;
  esac
}

main "$@"
